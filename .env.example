# EmailJS Configuration (Dev Portfolio)
# Sign up at https://www.emailjs.com/
#
# 1. Service ID: Created under "Email Services"
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# 2. Notification Template ID: Sent to your email with the visitor's message
# In EmailJS Template Settings:
#   To Email: {{to_email}} or your own email
#   Reply-To: {{reply_to}}  <-- enables clicking "Reply" directly in your email client
#   Content variables: {{name}}, {{email}}, {{subject}}, {{message}}
VITE_EMAILJS_TEMPLATE_NOTIFICATION_ID=your_notification_template_id_here

# 3. Confirmation Template ID: Auto-reply receipt sent to the visitor
# In EmailJS Template Settings:
#   To Email: {{to_email}}
#   Subject: Thanks for reaching out!
#   Content variables: {{to_name}}, {{subject}}, {{message}}
VITE_EMAILJS_TEMPLATE_CONFIRMATION_ID=your_confirmation_template_id_here

# 4. Public Key: Found in EmailJS under "Account" > "General" > "Public Key"
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
