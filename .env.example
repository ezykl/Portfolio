# EmailJS Configuration
# Sign up at https://www.emailjs.com/ (Free tier includes 200 emails/month)
#
# 1. Service ID: Created under "Email Services" (e.g., connected to your Gmail/Outlook)
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# 2. Notification Template ID: Sent to your email with the visitor's message
# In EmailJS Template Settings:
#   To Email: {{to_email}} or your own email
#   Reply-To: {{reply_to}}  <-- this lets you click "Reply" to email the visitor back directly
#   Content variables: {{name}}, {{email}}, {{subject}}, {{message}}
VITE_EMAILJS_TEMPLATE_NOTIFICATION_ID=your_notification_template_id_here

# 3. Confirmation Template ID: Auto-reply sent to the visitor
# In EmailJS Template Settings:
#   To Email: {{to_email}}
#   Subject: Thanks for reaching out!
#   Content variables: {{to_name}}, {{subject}}, {{message}}
VITE_EMAILJS_TEMPLATE_CONFIRMATION_ID=your_confirmation_template_id_here

# 4. Public Key: Found in EmailJS under "Account" > "General" > "Public Key"
# Note: Public Key is safe to be used client-side; never expose your Private/Secret Key.
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
